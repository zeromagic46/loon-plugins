#!name=JavDB去广告
#!desc=屏蔽开屏广告和页内广告图
#!author=zeromagic46
#!homepage=https://github.com/zeromagic46/loon-plugins
#!icon=https://c0.jdbstatic.com/images/logo_120x120.png

[Rewrite]
^https:\/\/tp\.spfcas\.com\/[^/]+\/ads\/ reject-img

[Script]
http-request ^https:\/\/apidd\.spthgb\.com\/api\/v1\/ads script-path=https://raw.githubusercontent.com/zeromagic46/loon-plugins/main/javdb-ads.js, timeout=10, tag=JavDB广告位
http-response ^https:\/\/apidd\.spthgb\.com\/api\/v1\/startup script-path=https://raw.githubusercontent.com/zeromagic46/loon-plugins/main/javdb-startup.js, requires-body=true, timeout=10, tag=JavDB开屏

[Rule]
DOMAIN-SUFFIX,zenaruk.com,REJECT
DOMAIN-SUFFIX,jopeki.com,REJECT
DOMAIN-SUFFIX,tkoqk.com,REJECT
DOMAIN-SUFFIX,win6017.com,REJECT
DOMAIN-SUFFIX,2vtt7a4.xyz,REJECT

[MitM]
hostname = apidd.spthgb.com, jdforrepam.com, tp.spfcas.com
